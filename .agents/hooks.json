{
  "hooks": [
    {
      "id": "ensure-enterprise-deps",
      "description": "Ensures distributed systems dependencies are installed.",
      "events": ["pre_tool_call"],
      "conditions": {
        "tool_names": ["run_command"],
        "command_patterns": ["uvicorn", "python mock_edge_fleet.py"]
      },
      "action": {
        "type": "command",
        "command": "pip install fastapi uvicorn paho-mqtt sqlalchemy",
        "blocking": true
      }
    }
  ]
}
